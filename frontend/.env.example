# ═══════════════════════════════════════════════════════════════════════════
# CookShare Frontend — Environment Variables
#
# These are set AUTOMATICALLY by the Makefile (make dev / make prod).
# You do NOT need to edit this file manually in normal use.
#
# The Docker Compose file reads DOMAIN from the Makefile and sets:
#   VITE_API_URL=https://${DOMAIN}/api/v1
#   VITE_WS_URL=https://${DOMAIN}
#
# If no VITE_API_URL is set, the url-resolver uses window.location.origin.
# ═══════════════════════════════════════════════════════════════════════════

# API base URL (set automatically by make dev / make prod)
# VITE_API_URL=https://cookshare.me/api/v1
# VITE_API_URL=https://192.168.1.42/api/v1

# WebSocket URL (set automatically)
# VITE_WS_URL=https://cookshare.me
# VITE_WS_URL=https://192.168.1.42

# App name
VITE_APP_NAME=cookshare

# Debug mode
VITE_DEBUG=true

# API request timeout (ms)
VITE_API_TIMEOUT=30000
