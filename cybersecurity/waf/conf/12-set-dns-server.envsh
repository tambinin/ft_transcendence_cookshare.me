#!/bin/sh
# Set DNS_SERVER from /etc/resolv.conf for envsubst templates
# Compatible with both Docker (127.0.0.11) and Podman DNS resolvers

DNS_SERVER=$(awk 'BEGIN{ORS=" "} $1=="nameserver" {if ($2 ~ ":") {print "["$2"]"} else {print $2}}' /etc/resolv.conf)
DNS_SERVER="${DNS_SERVER% }"

# Fallback to Docker embedded DNS if nothing found
if [ -z "$DNS_SERVER" ]; then
    DNS_SERVER="127.0.0.11"
fi

export DNS_SERVER
